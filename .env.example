# ============================================================
#  환경변수 템플릿 (이 파일은 git에 커밋됨 — 실제 비밀값 넣지 말 것)
#  사용법:  cp .env.example .env   →  .env에 실제 값 채우기
#  .env 는 .gitignore 로 제외되어 절대 커밋되지 않음
# ============================================================

# --- TourAPI (한국관광공사, data.go.kr 발급 인증키) ---
# 데이터 수집 배치에서 사용. 관광정보 + 관광자원통계(방문자수) 공용 키.
TOUR_API_KEY=

# --- Claude API (Anthropic) ---
# 질의이해 + 답변 생성에 사용. console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database (Postgres + pgvector) ---
# 로컬은 docker-compose의 postgres 컨테이너 기준 기본값.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=odygo
POSTGRES_USER=odygo
POSTGRES_PASSWORD=change-me-in-real-env
# 앱은 보통 위 값으로 조립하거나 아래 URL을 직접 사용
DATABASE_URL=postgresql://odygo:change-me-in-real-env@localhost:5432/odygo

# --- 임베딩 / 리랭커 모델 ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- API / 보안 설정 ---
# CORS 허용 오리진 (프론트 주소). 쉼표로 여러 개.
ALLOWED_ORIGINS=http://localhost:3000
# 채팅 엔드포인트 레이트리밋 (분당 요청 수)
RATE_LIMIT_PER_MINUTE=20
# 비용 가드: 답변 1회 최대 출력 토큰
MAX_OUTPUT_TOKENS=1024
